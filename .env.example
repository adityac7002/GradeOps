# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=GradeOps
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-256-bit-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database ──────────────────────────────────────────────────────────────────
# Development (SQLite):
DATABASE_URL=sqlite:///./gradeops.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://gradeops:password@localhost:5432/gradeops

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=100

# ── AI Provider ───────────────────────────────────────────────────────────────
# OCR model: gemini | qwen2-vl | trocr
OCR_MODEL=gemini
# LLM provider for grading: gemini | ollama | openai
LLM_PROVIDER=gemini

# Google Gemini (used for OCR + grading)
GOOGLE_API_KEY=

# OpenAI (optional alternative)
# OPENAI_API_KEY=

# Ollama (local; requires Ollama running)
OLLAMA_MODEL=llama3.2

# ── Background Tasks ──────────────────────────────────────────────────────────
GRADING_CONCURRENCY=4
TASK_MAX_RETRIES=3

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=5

# ── Seed Accounts (development only — change in production!) ──────────────────
SEED_ADMIN_EMAIL=admin@gradeops.com
SEED_ADMIN_PASSWORD=admin123
SEED_TA_EMAIL=ta@gradeops.com
SEED_TA_PASSWORD=ta123
